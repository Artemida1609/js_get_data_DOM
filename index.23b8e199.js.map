'use strict';
// write your code here
var body = document.body;
var population = body.querySelectorAll('.population');
var total = 0;
for(var i = 0; i < population.length; i++){
    var formattedNumber = parseInt(population[i].innerHTML.replace(/[,]/g, ''));
    total += formattedNumber;
}
var average = Math.ceil(total / population.length);
document.getElementById('totalPopulation').innerHTML = numberWithCommas(total);
document.getElementById('averagePopulation').innerHTML = numberWithCommas(average);
function numberWithCommas(x) {
    var num = x;
    num = num.toString();
    var pattern = /(-?\d+)(\d{3})/;
    while(pattern.test(num))num = num.replace(pattern, '$1,$2');
    return num;
}

